{
 "doctype":"DocType",
 "engine":"InnoDB",
 "istable":1,
 "field_order":["requirement_code","requirement_type","course","sequence","active","requirement_name","course_category","minimum_courses","minimum_credits","minimum_grade","notes"],
 "fields":[
  {"fieldname":"requirement_code","fieldtype":"Data","label":"Requirement Code","reqd":1,"in_list_view":1},
  {"fieldname":"requirement_type","fieldtype":"Select","label":"Requirement Type","options":"Required Course\nCourse Group\nMinimum Credits","reqd":1,"in_list_view":1},
  {"fieldname":"course","fieldtype":"Link","label":"Course Name","options":"Course","depends_on":"eval:doc.requirement_type == 'Required Course'","in_list_view":1},
  {"fieldname":"sequence","fieldtype":"Int","label":"Sequence","reqd":1,"in_list_view":1},
  {"default":"1","fieldname":"active","fieldtype":"Check","label":"Active","in_list_view":1},
  {"fieldname":"requirement_name","fieldtype":"Data","label":"Requirement Name","hidden":1},
  {"fieldname":"course_category","fieldtype":"Link","label":"Course Category","options":"Course Category","depends_on":"eval:doc.requirement_type == 'Course Group'"},
  {"default":"1","fieldname":"minimum_courses","fieldtype":"Int","label":"Minimum Courses","depends_on":"eval:doc.requirement_type == 'Course Group'"},
  {"default":"0","fieldname":"minimum_credits","fieldtype":"Float","label":"Minimum Credits"},
  {"default":"C","fieldname":"minimum_grade","fieldtype":"Data","label":"Minimum Grade"},
  {"fieldname":"notes","fieldtype":"Small Text","label":"Notes"}
 ],
 "module":"Talisma SIS",
 "name":"Talisma Curriculum Requirement"
}
